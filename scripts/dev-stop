#!/usr/bin/env bash
set -euo pipefail

# The same file set `scripts/dev-start` brings up, so `down` resolves the same
# project. Neither flag changes it any more: the overlay is unconditional and
# the tunnel connector lives in compose.yaml, and `down` stops every service in
# the project regardless. Both are still accepted so that a stop can be spelled
# the same way as the start it undoes.
compose=(podman compose -f compose.yaml -f compose.custom.yaml)
for argument in "$@"; do
  case "${argument}" in
    --rails | --tunnel) ;;
    *) echo "Usage: $0 [--rails] [--tunnel]" >&2; exit 2 ;;
  esac
done
"${compose[@]}" down
