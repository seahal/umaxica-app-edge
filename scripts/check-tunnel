#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${EDGE_TUNNEL_RAILS_URL:-} ]]; then
  echo 'BLOCKED: set EDGE_TUNNEL_RAILS_URL to the Access-protected development Rails check URL.' >&2
  exit 2
fi

# Access service tokens were retired along with every other long-lived
# credential. `cloudflared access login` opens the Access login page in a
# browser and stores a short-lived JWT in this container only; `cloudflared
# access curl` then attaches it. Re-run the login when the JWT expires.
if ! command -v cloudflared >/dev/null 2>&1; then
  echo 'BLOCKED: cloudflared is not installed in this container.' >&2
  exit 2
fi

if ! cloudflared access token --app "${EDGE_TUNNEL_RAILS_URL}" >/dev/null 2>&1; then
  echo 'No valid Access token in this container. Opening the browser login flow...' >&2
  cloudflared access login "${EDGE_TUNNEL_RAILS_URL}"
fi

cloudflared access curl --fail --silent --show-error --max-time 20 --output /dev/null \
  "${EDGE_TUNNEL_RAILS_URL}"
echo 'PASS: HTTPS reached the Access-protected development Tunnel path.'
