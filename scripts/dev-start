#!/usr/bin/env bash
set -euo pipefail

use_rails=false
use_tunnel=false
for argument in "$@"; do
  case "${argument}" in
    --rails) use_rails=true ;;
    --tunnel) use_tunnel=true ;;
    *) echo "Usage: $0 [--rails] [--tunnel]" >&2; exit 2 ;;
  esac
done

if [[ ${EUID} -eq 0 || -n ${SUDO_UID:-} ]]; then
  echo 'ERROR: the Edge environment must be started with rootless Podman, never root or sudo.' >&2
  exit 1
fi
if ! rootless=$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null) || [[ ${rootless} != true ]]; then
  echo 'ERROR: rootless Podman is unavailable. Check `podman info` as your normal user.' >&2
  exit 1
fi

mapfile -t unmasked_env_files < <(
  find . \
    -path './.git' -prune -o \
    -path './node_modules' -prune -o \
    -path './.claude' -prune -o \
    -type f \( \
      -name '.dev.vars' -o \
      -name '.env.local' -o \
      -name '.env.test.local' -o \
      -name '.env.production.local' \
    \) -print
)
if ((${#unmasked_env_files[@]} > 0)); then
  echo 'ERROR: unmasked ignored environment files would enter through the workspace bind:' >&2
  printf '  %s\n' "${unmasked_env_files[@]}" >&2
  echo 'Move dedicated credential inputs under .secrets/ and register them with Podman Secret.' >&2
  exit 1
fi

# The overlay is not optional. It carries the SELinux `label=disable` without
# which `/home/edge/workspace` is unreadable inside the container on an
# Enforcing host, and the host GitHub identity (known_hosts, GH_TOKEN).
# `.devcontainer/devcontainer.json` has always loaded both files; loading only
# one here meant a bare `scripts/dev-start` produced a container that differed
# from the one the editor starts.
#
# `compose.custom.yaml` itself is gitignored, so that a host-specific override
# is never a diff anybody has to carry. Seed it from the tracked template on a
# fresh clone: `devcontainer up` reads the path directly and would otherwise
# fail with a bare "no such file", which says nothing about what to do next.
if [[ ! -e compose.custom.yaml ]]; then
  echo 'compose.custom.yaml is missing; seeding it from compose.custom.yaml.example.' >&2
  cp compose.custom.yaml.example compose.custom.yaml
fi

compose=(podman compose -f compose.yaml -f compose.custom.yaml)
services=(core)

# Podman invents a missing bind source as a DIRECTORY. For known_hosts that
# would silently create `~/.ssh/known_hosts/` on the HOST and leave every later
# `ssh` reading an empty file it cannot explain, so refuse before starting.
if [[ ! -f ${HOME}/.ssh/known_hosts ]]; then
  echo "ERROR: ${HOME}/.ssh/known_hosts is not a regular file." >&2
  echo 'The container binds it read-only; Podman would otherwise create a directory there.' >&2
  echo '  ssh-keyscan github.com >> ~/.ssh/known_hosts' >&2
  exit 1
fi

# The default overlay forwards no ssh-agent socket: binding one is a per-host
# fact (the socket path exists on some machines and not others, and a stale
# value fails the bind before any container starts), so it belongs in your own
# `compose.custom.yaml` rather than in the template everyone copies. Say so
# once, because silence would be the wrong answer to "why does git ask for a
# password inside the container?".
if ! grep -q '/ssh-agent' compose.custom.yaml; then
  echo 'NOTE: no ssh-agent socket is forwarded; Git over SSH will not work in the container.' >&2
  echo '  Use gh/HTTPS, or add the bind to your own compose.custom.yaml:' >&2
  echo '    - { type: bind, source: ${SSH_AUTH_SOCK}, target: /ssh-agent }' >&2
fi

# Optional by design -- compose falls back to an empty token -- but the same
# reasoning applies.
if [[ -z ${GH_TOKEN:-} ]]; then
  echo 'WARNING: GH_TOKEN is unset; the gh CLI will fall back to its in-image state.' >&2
  echo '  export GH_TOKEN="$(gh auth token)"' >&2
fi

if [[ ${use_rails} == true ]]; then
  if [[ -z ${EDGE_RAILS_NETWORK:-} ]]; then
    echo 'ERROR: --rails requires EDGE_RAILS_NETWORK to name the existing Rails rootless Podman network.' >&2
    echo 'Inspect available networks with: podman network ls' >&2
    exit 1
  fi
  if ! podman network exists "${EDGE_RAILS_NETWORK}"; then
    echo "ERROR: Rails network does not exist: ${EDGE_RAILS_NETWORK}" >&2
    echo 'Inspect available networks with `podman network ls`, then set EDGE_RAILS_NETWORK.' >&2
    exit 1
  fi
fi

# Independent of --rails on purpose: inbound Edge exposure and outbound Rails
# connectivity answer different questions. The connector is defined in
# `compose.yaml` because it is shared, so this adds no overlay — it only asks for
# the service to be started. It uses this compose project's default network and
# requires an Edge-specific token from `.env`.
if [[ ${use_tunnel} == true ]]; then
  # Compose reads the repo-root `.env` itself; bash does not. Check both, or a
  # token that is present and working would be reported as missing.
  if [[ -z ${EDGE_CLOUDFLARED_TOKEN:-} && -z ${CLOUDFLARED_TOKEN:-} ]] &&
    ! { [[ -f .env ]] && grep -Eq '^(EDGE_)?CLOUDFLARED_TOKEN=.+' .env; }; then
    echo 'ERROR: --tunnel requires EDGE_CLOUDFLARED_TOKEN (or CLOUDFLARED_TOKEN) in .env.' >&2
    exit 1
  fi
  services+=(cloudflare-tunnel)
fi

# There is no credential overlay any more. Long-lived API tokens and Podman
# Secrets were retired. GitHub access is the host's, borrowed rather than copied
# -- the ssh-agent socket and GH_TOKEN forwarded by `compose.custom.yaml`, with
# no key file and no token literal anywhere in the repository. Everything else
# is a short-lived credential obtained inside the container:
#   scripts/wrangler-login
#   claude   # /login
#   codex login
# None of those is persisted: recreating the container requires logging in again.

"${compose[@]}" up -d "${services[@]}"
