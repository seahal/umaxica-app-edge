#!/usr/bin/env bash
set -euo pipefail

use_rails=false
use_tunnel=false
use_remote_access=false
for argument in "$@"; do
  case "${argument}" in
    --rails) use_rails=true ;;
    --tunnel) use_tunnel=true ;;
    --remote-access) use_remote_access=true ;;
    *) echo "Usage: $0 [--rails] [--tunnel] [--remote-access]" >&2; exit 2 ;;
  esac
done

if [[ ${EUID} -eq 0 || -n ${SUDO_UID:-} ]]; then
  echo 'ERROR: the Edge environment must be started with rootless Podman, never root or sudo.' >&2
  exit 1
fi
if ! rootless=$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null) || [[ ${rootless} != true ]]; then
  echo 'ERROR: rootless Podman is unavailable. Check `podman info` as your normal user.' >&2
  exit 1
fi

mapfile -t unmasked_env_files < <(
  find . \
    -path './.git' -prune -o \
    -path './node_modules' -prune -o \
    -path './.claude' -prune -o \
    -type f \( \
      -name '.dev.vars' -o \
      -name '.env.local' -o \
      -name '.env.test.local' -o \
      -name '.env.production.local' \
    \) -print
)
if ((${#unmasked_env_files[@]} > 0)); then
  echo 'ERROR: unmasked ignored environment files would enter through the workspace bind:' >&2
  printf '  %s\n' "${unmasked_env_files[@]}" >&2
  echo 'Move dedicated credential inputs under .secrets/ and register them with Podman Secret.' >&2
  exit 1
fi

compose=(podman compose -f compose.yaml)
services=(core)

if [[ ${use_rails} == true ]]; then
  if [[ -z ${EDGE_RAILS_NETWORK:-} ]]; then
    echo 'ERROR: --rails requires EDGE_RAILS_NETWORK to name the existing Rails rootless Podman network.' >&2
    echo 'Inspect available networks with: podman network ls' >&2
    exit 1
  fi
  if ! podman network exists "${EDGE_RAILS_NETWORK}"; then
    echo "ERROR: Rails network does not exist: ${EDGE_RAILS_NETWORK}" >&2
    echo 'Inspect available networks with `podman network ls`, then set EDGE_RAILS_NETWORK.' >&2
    exit 1
  fi
  compose+=(-f compose.custom.yaml)
fi

# Independent of --rails on purpose: inbound Edge exposure and outbound Rails
# connectivity answer different questions. The connector is defined in
# `compose.yaml` because it is shared, so this adds no overlay — it only asks for
# the service to be started. It uses this compose project's default network and
# requires an Edge-specific token from `.env`.
if [[ ${use_tunnel} == true ]]; then
  # Compose reads the repo-root `.env` itself; bash does not. Check both, or a
  # token that is present and working would be reported as missing.
  if [[ -z ${EDGE_CLOUDFLARED_TOKEN:-} && -z ${CLOUDFLARED_TOKEN:-} ]] &&
    ! { [[ -f .env ]] && grep -Eq '^(EDGE_)?CLOUDFLARED_TOKEN=.+' .env; }; then
    echo 'ERROR: --tunnel requires EDGE_CLOUDFLARED_TOKEN (or CLOUDFLARED_TOKEN) in .env.' >&2
    exit 1
  fi
  services+=(cloudflare-tunnel)
fi

# Inbound SSH from the tailnet, terminating in `core` rather than in the
# sidecar. See `docs/development/tailscale-remote-ssh.md`.
#
# Every check lives in the preflight script rather than here, so that the
# devcontainer path, a bare `podman compose` and this script all enforce the same
# rules -- including the one that matters most, refusing to start while a spent
# TS_AUTHKEY is still sitting in `.env`.
if [[ ${use_remote_access} == true ]]; then
  .devcontainer/remote-access-preflight.sh

  compose+=(-f compose.remote-access.yaml)
  services+=(tailscale)
fi

# There is no credential overlay any more. Long-lived API tokens and Podman
# Secrets were retired in favour of short-lived, browser-issued credentials
# obtained inside the container:
#   gh auth login --web --git-protocol https && gh auth setup-git
#   scripts/wrangler-login
#   claude   # /login
#   codex login
# Nothing is persisted: recreating the container requires logging in again.

"${compose[@]}" up -d "${services[@]}"
