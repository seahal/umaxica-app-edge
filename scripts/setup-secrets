#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ ${EUID} -eq 0 || -n ${SUDO_UID:-} || -n ${SUDO_USER:-} ]]; then
  echo 'ERROR: run scripts/setup-secrets as the normal rootless Podman user, never as root or through sudo.' >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "${repo_root}"

if [[ ! -d .secrets || -L .secrets ]]; then
  echo 'ERROR: .secrets must be a real directory. Create it locally with mode 0700.' >&2
  exit 1
fi
if [[ $(stat -c '%a' .secrets) != 700 ]]; then
  echo 'ERROR: .secrets must have mode 0700 (run: chmod 700 .secrets).' >&2
  exit 1
fi

git check-ignore --no-index --quiet .secrets/.ignore-probe || {
  echo 'ERROR: .secrets/ is not excluded by .gitignore.' >&2
  exit 1
}

for ignore_file in .containerignore .dockerignore; do
  if ! awk '
    { sub(/#.*/, ""); gsub(/[[:space:]]/, "") }
    $0 == ".secrets" || $0 == ".secrets/" { found = 1 }
    END { exit found ? 0 : 1 }
  ' "${ignore_file}"; then
    echo "ERROR: .secrets/ is not excluded by ${ignore_file}." >&2
    exit 1
  fi
done

if ! rootless=$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null) || [[ ${rootless} != true ]]; then
  echo 'ERROR: rootless Podman is required and is not available to this user.' >&2
  exit 1
fi

declare -A sources=(
  [dev_github_token]='.secrets/github_token'
  [dev_cloudflare_access_client_id]='.secrets/cloudflare_access_client_id'
  [dev_cloudflare_access_client_secret]='.secrets/cloudflare_access_client_secret'
  [dev_claude_api_key]='.secrets/claude_api_key'
  [dev_codex_api_key]='.secrets/codex_api_key'
)

if (($# == 0)); then
  requested=("${!sources[@]}")
else
  requested=("$@")
fi

for secret_name in "${requested[@]}"; do
  source_path=${sources[${secret_name}]:-}
  if [[ -z ${source_path} ]]; then
    echo "ERROR: unknown secret name: ${secret_name}" >&2
    exit 1
  fi
  if [[ ! -f ${source_path} || -L ${source_path} ]]; then
    echo "ERROR: ${source_path} must be a regular, non-symbolic-link file." >&2
    exit 1
  fi
  if [[ $(stat -c '%F' "${source_path}") != 'regular file' ]]; then
    echo "ERROR: ${source_path} is not a regular file." >&2
    exit 1
  fi
  if [[ $(stat -c '%a' "${source_path}") != 600 ]]; then
    echo "ERROR: ${source_path} must have mode 0600." >&2
    exit 1
  fi
  if [[ ! -s ${source_path} ]]; then
    echo "ERROR: ${source_path} is empty." >&2
    exit 1
  fi

  podman secret create --replace "${secret_name}" "${source_path}" >/dev/null
  echo "REGISTERED ${secret_name}"
done
