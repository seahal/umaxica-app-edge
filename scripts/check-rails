#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${EDGE_RAILS_NETWORK:-} ]]; then
  echo 'BLOCKED: set EDGE_RAILS_NETWORK and start with scripts/dev-start --rails.' >&2
  exit 2
fi
if ! podman network exists "${EDGE_RAILS_NETWORK}"; then
  echo "FAIL: configured Rails network does not exist: ${EDGE_RAILS_NETWORK}" >&2
  exit 1
fi

# The optional local override, only when it exists -- it can change nothing
# this check depends on, but resolving the same file set keeps us in the same
# Compose project as `scripts/dev-start`.
override=()
if [[ -e compose.override.yaml ]]; then
  override=(-f compose.override.yaml)
fi

for brand in app com org; do
  for frame in core docs help info news; do
    origin="http://${frame}.${brand}.localhost:3000"
    if podman compose -f compose.yaml "${override[@]}" exec -T core \
      curl --fail --silent --show-error --max-time 10 --output /dev/null \
      "${origin}/health/liveness.json"; then
      echo "PASS ${origin}"
    else
      echo "FAIL ${origin}" >&2
      exit 1
    fi
  done
done
