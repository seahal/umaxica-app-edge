#!/usr/bin/env bash
set -euo pipefail

tailscale version

socket=$(mktemp -u /tmp/edge-tailscaled.XXXXXX.sock)
state=$(mktemp /tmp/edge-tailscaled-state.XXXXXX)
log=$(mktemp /tmp/edge-tailscaled-log.XXXXXX)
trap 'kill "${daemon_pid:-}" 2>/dev/null || true; rm -f "${socket}" "${state}" "${log}"' EXIT

tailscaled --tun=userspace-networking --state="${state}" --socket="${socket}" >"${log}" 2>&1 &
daemon_pid=$!
for _ in {1..20}; do
  [[ -S ${socket} ]] && break
  kill -0 "${daemon_pid}" 2>/dev/null || {
    echo 'FAIL: tailscaled exited during userspace startup feasibility check.' >&2
    exit 1
  }
  sleep 0.1
done
[[ -S ${socket} ]] || {
  echo 'FAIL: tailscaled did not create its userspace socket.' >&2
  exit 1
}

tailscale --socket="${socket}" status >/dev/null 2>&1 || true
echo 'PASS: Tailscale tooling and userspace daemon startup are feasible; no tailnet join was attempted.'
