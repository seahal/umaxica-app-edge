# Rails, development transport. See adr/005-rails-edge-workers-vpc-connection.md.
#
# Copy this file to `.env.development.local` (gitignored) and fill in the two
# token values. Next.js loads `.env.development.local` first, ahead of every
# other `.env*` file, whenever NODE_ENV is `development`. This file itself is
# never loaded — `.env.example` is not one of the names Next.js reads.
#
# production needs none of this: it reaches Rails over the Workers VPC binding,
# which is a Cloudflare binding rather than an environment value.
#
# All three must be set together, or the client fails closed to
# `not-configured`. Leave them unset to develop without Rails.

# One origin for every frame, on purpose.
#
# The VPC service production uses targets exactly one Rails origin,
# `core.app.localhost:3000`. `core-jp.umaxica.app` is the public hostname for
# that same internal service on the same tunnel, so development and production
# reach the identical origin. Frames stay distinguishable by their path prefix
# (`/{frame}/{brand}`), which is the same on both transports.
#
# The Rails tunnel also publishes `core-jp.umaxica.com` and `core-jp.umaxica.org`.
# Do NOT move individual frames onto those: production has no per-brand VPC
# service, so development would start reaching a different origin than
# production and the gap would only surface after a deploy. Migrating means
# per-brand VPC services first, then all fifteen values together.
PUBLIC_CORE_RAILS_ORIGIN=https://core-jp.umaxica.app

# Cloudflare Access service token. A credential — never commit a filled-in value,
# and never put it in wrangler.jsonc, whose `vars` ship with the Worker.
PUBLIC_CORE_ACCESS_CLIENT_ID=
PUBLIC_CORE_ACCESS_CLIENT_SECRET=
