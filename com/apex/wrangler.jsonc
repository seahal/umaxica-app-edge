{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-apex-com",
  "keep_vars": true,
  "compatibility_date": "2026-02-27",
  "compatibility_flags": ["nodejs_als"],
  "main": "./src/index.tsx",
  "assets": { "directory": "./public" },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  /**
   * THE TOP LEVEL IS PRODUCTION. There is no `env.production`.
   *
   * A wrangler environment deploys to a separate Worker named `<name>-<env>`,
   * so an `env.production` has to re-declare `name` purely to cancel that
   * out. Cloudflare's model is that the top level is the real Worker and
   * environments are the variants, so `wrangler deploy` with no `--env` is
   * the production deploy.
   *
   * The deploy scripts blank CLOUDFLARE_ENV: compose.yaml exports
   * `CLOUDFLARE_ENV=development`, and with no `--env` that variable alone
   * would redirect the deploy to `<name>-development`. Measured, not assumed.
   *
   * The tier itself is exposed to the Worker as `EDGE_ENV`, never as
   * `CLOUDFLARE_ENV`. `opennextjs-cloudflare upload` reads the Worker vars
   * through `getPlatformProxy()` and writes every string one into its own
   * `process.env` before spawning wrangler, so a var named CLOUDFLARE_ENV
   * comes back as `--env=production` and the upload dies looking for an
   * `env.production` that deliberately does not exist. Measured, not assumed;
   * tools/check-workers.mjs enforces the separation.
   */
  "vars": {
    "EDGE_ENV": "production",
    "BRAND_NAME": "UMAXICA"
  },
  /**
   * The apex hostname is owned by the development Cloudflare Tunnel, so this
   * Worker claims no route at all — see adr/008-edge-development-tunnel-exposure.md.
   *
   * This used to declare `{ pattern: "<apex>", custom_domain: true }` so that
   * `wrangler deploy` would reconcile the binding on every production deploy and
   * stop a hand-edited dashboard entry from pointing the hostname elsewhere. That
   * property is now the exact hazard: a custom domain and a Tunnel Public
   * Hostname cannot both own one name, so a production deploy would reclaim the
   * hostname from the Tunnel and silently break the development route.
   *
   * Empty is therefore load-bearing, not a leftover. Restoring the apex domain to
   * this Worker means removing the Tunnel's Public Hostname entry first, then
   * putting the `routes` entry back — in that order.
   *
   * Named environments DO inherit this key, so `env.development` and
   * `env.test` keep pinning `"routes": []` for their own reasons.
   */
  "routes": [],

  "env": {
    "development": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "EDGE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      // Required, not decorative: `routes` IS inherited by named environments,
      // so without this an `--env development` deploy reassigns the production
      // custom domain to `<name>-development`. Measured via `--dry-run`.
      "routes": [],
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        }
      },
      "kv_namespaces": [
        {
          "binding": "BREAKER_KV",
          "id": "38d85c2cbf3c4578b9fb2bf999affda9"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    /**
     * `test` is never deployed — it exists so `wrangler dev --env test` and a
     * future @cloudflare/vitest-pool-workers setup resolve test-tier config.
     * Only non-inheritable keys are repeated here; inheritable ones (observability,
     * placement, compatibility_*) fall through from the top level.
     */
    "test": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "EDGE_ENV": "test",
        "BRAND_NAME": "UMAXICA"
      },
      // See the note in `env.development` — blocks route inheritance.
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "BREAKER_KV",
          // TODO: point at a test-only namespace once one is provisioned.
          // Shares production's id today; harmless while test stays local
          // (miniflare simulates KV in-memory and ignores the id).
          "id": "38d85c2cbf3c4578b9fb2bf999affda9"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "3002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    }
  },
  "placement": { "mode": "smart" },
  "kv_namespaces": [
    {
      "binding": "BREAKER_KV",
      "id": "38d85c2cbf3c4578b9fb2bf999affda9"
    }
  ],
  /**
   * Rate Limiting
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
   */
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 2000,
        "period": 60
      }
    }
  ]
}
