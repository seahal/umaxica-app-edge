{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-apex-com",
  "keep_vars": true,
  "compatibility_date": "2026-02-27",
  "compatibility_flags": ["nodejs_als"],
  "main": "./src/index.tsx",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": false,
  "preview_urls": true,
  "upload_source_maps": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.2
    }
  },
  "env": {
    "development": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "CLOUDFLARE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 0.2,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.2,
          "persist": true
        }
      },
      "kv_namespaces": [
        {
          "binding": "BREAKER_KV",
          "id": "38d85c2cbf3c4578b9fb2bf999affda9"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    /**
     * `test` is never deployed — it exists so `wrangler dev --env test` and a
     * future @cloudflare/vitest-pool-workers setup resolve test-tier config.
     * Only non-inheritable keys are repeated here; inheritable ones (observability,
     * placement, compatibility_*) fall through from the top level.
     */
    "test": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "CLOUDFLARE_ENV": "test",
        "BRAND_NAME": "UMAXICA"
      },
      "kv_namespaces": [
        {
          "binding": "BREAKER_KV",
          // TODO: point at a test-only namespace once one is provisioned.
          // Shares production's id today; harmless while test stays local
          // (miniflare simulates KV in-memory and ignores the id).
          "id": "38d85c2cbf3c4578b9fb2bf999affda9"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "3002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "umaxica-apps-edge-apex-com",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "CLOUDFLARE_ENV": "production",
        "BRAND_NAME": "UMAXICA"
      },
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 0.2,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.2,
          "persist": true
        }
      },
      "kv_namespaces": [
        {
          "binding": "BREAKER_KV",
          "id": "38d85c2cbf3c4578b9fb2bf999affda9"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    }
  },
  "placement": { "mode": "smart" },
  "kv_namespaces": [
    {
      "binding": "BREAKER_KV",
      "id": "38d85c2cbf3c4578b9fb2bf999affda9"
    }
  ],
  /**
   * Rate Limiting
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
   */
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 2000,
        "period": 60
      }
    }
  ]
}
