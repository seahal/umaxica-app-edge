{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // No `nextjs` plugin: this unit is TanStack Start on Vite, and the plugin's
  // rules are about a framework that is no longer here. Left enabled it reported
  // `no-html-link-for-pages` on the ordinary `<a href="/">` in the offline and
  // failure documents — advice to import `next/link`, in a unit with no `next`
  // dependency at all.
  "plugins": ["typescript", "react", "jsx-a11y", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "afterEach": "readonly",
    "beforeEach": "readonly",
    "describe": "readonly",
    "expect": "readonly",
    "it": "readonly",
    "vi": "readonly"
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "react/no-danger": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/shared/**", "**/shared/*"],
            "message": "shared/ has been removed. Each frame owns its own components, types, hooks, and utilities — copy the implementation into this frame instead of reintroducing a shared module. (Cross-unit imports are a separate invariant, owned by test/deployment-unit-boundaries.test.ts — this rule only stops a shared/ directory coming back.)"
          },
          {
            "group": [
              "react-aria",
              "react-aria/*",
              "react-stately",
              "react-stately/*",
              "@react-aria/*",
              "@react-stately/*",
              "@react-types/*",
              "@internationalized/*"
            ],
            "message": "Import from `react-aria-components` only. These packages are its internals — `react-aria-components` pulls `react-aria` 3.51.0 and `react-stately` 3.49.0 in itself and imports them at ~790 sites — and this unit declares none of them, so a direct import also depends on a package its package.json does not list. If a react-aria-components API genuinely requires one of these as a value type (@internationalized/date for the date components is the known case), that is a decision to record in docs/design/ui-shell-contract.md §3a, not to work around here."
          }
        ]
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": "off",
    "vitest/valid-title": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "expectTitleContract",
          "expectFailClosed"
        ]
      }
    ],
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/require-await": "off",
    "eslint/prefer-promise-reject-errors": "off",
    "promise/no-promise-in-callback": "off",
    "import/max-dependencies": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/strict-void-return": "off",
    "typescript/require-await": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/consistent-return": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      // TanStack's control-flow signals are plain objects rather than `Error`
      // subclasses — `notFound()` and `redirect()` each return one for the caller
      // to throw, and the router identifies them structurally. Throwing an
      // `Error` instead would not be recognised at all, so there is no code
      // change that satisfies `only-throw-error` and keeps the behaviour: the
      // rule and the framework's API genuinely disagree.
      //
      // Scoped to the two files that raise them rather than disabled unit-wide,
      // and set here rather than with an inline directive because the rule is
      // type-aware only — `pnpm run lint` would report the directive itself as
      // unused. Removable if TanStack ships Error-derived signals.
      "files": ["src/i18n/dictionaries.ts", "src/routes/_page.home.tsx"],
      "rules": {
        "typescript/only-throw-error": "off"
      }
    },
    {
      "files": ["test/**", "**/*.test.ts", "**/*.test.tsx", "e2e/**", "**/__mocks__/**"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/non-nullable-type-assertion-style": "off"
      }
    },
    {
      "files": [
        "**/app/error.tsx",
        "**/app/global-error.tsx",
        "**/app/global-not-found.tsx",
        "**/app/offline/page.tsx"
      ],
      "rules": {
        "nextjs/no-html-link-for-pages": "off"
      }
    },
    {
      "files": ["**/next-handler.ts"],
      "rules": {
        "typescript/prefer-ts-expect-error": "off",
        "typescript/ban-ts-comment": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": ["tools/**", "scripts/**", "public/**", "*.mjs", "*.cjs"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/await-thenable": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "typescript/non-nullable-type-assertion-style": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/.wrangler/**",
    "**/dist/**",
    "**/node_modules/**",
    "worker-configuration.d.ts",
    "**/routeTree.gen.ts",
    "**/+types/**",
    "**/build/**"
  ]
}
