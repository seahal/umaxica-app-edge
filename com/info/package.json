{
  "name": "umaxica-apps-edge-com-info",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run cf-typegen && CLOUDFLARE_ENV= opennextjs-cloudflare build",
    "build:next": "next build",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "deploy": "pnpm run cf-typegen && CLOUDFLARE_ENV= opennextjs-cloudflare build && CLOUDFLARE_ENV= opennextjs-cloudflare deploy",
    "deploy:upload": "pnpm run cf-typegen && CLOUDFLARE_ENV= opennextjs-cloudflare build && CLOUDFLARE_ENV= opennextjs-cloudflare upload",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --yes",
    "upload:ci": "CLOUDFLARE_ENV= opennextjs-cloudflare upload",
    "deploy:ci": "CLOUDFLARE_ENV= opennextjs-cloudflare deploy",
    "dev": "EDGE_LOCAL_NODE_RUNTIME=1 next dev --hostname 0.0.0.0 --port 5103",
    "preview": "opennextjs-cloudflare build --env development && opennextjs-cloudflare preview --env development",
    "preview:vpc": "opennextjs-cloudflare build --env vpc && opennextjs-cloudflare preview --env vpc",
    "typecheck": "pnpm run cf-typegen && tsgo --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "lint": "oxlint --type-aware --fix .",
    "lint:check": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.1",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
