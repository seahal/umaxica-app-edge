{
  // Wrangler config for the Astro build ONLY (`astro build` / `astro:preview`).
  // Passed to the adapter via `cloudflare({ configPath: './wrangler.astro.jsonc' })`
  // in astro.config.mjs so the Cloudflare Vite plugin does not pick up the
  // TanStack Start `wrangler.jsonc`, whose `main` points at `src/server.ts`.
  //
  // No `main`: the Astro Cloudflare adapter generates the Worker entry for the
  // on-demand routes (`/`, `/health`, `/revision`) and writes the deployable
  // `dist/astro/wrangler.json` itself. This file supplies bindings, vars and the
  // compat settings only.
  //
  // Pilot scope — juxtaposed with wrangler.jsonc, not replacing it. Phase 2 of
  // plans/tanstack-start-agile-reddy.md folds this back into one config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-org-docs-astro",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "version_metadata": { "binding": "REVISION" },
  "observability": {
    "enabled": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  },
  "upload_source_maps": false,
  "placement": { "mode": "smart" },
  "vars": {
    "EDGE_ENV": "production",
    "NODE_ENV": "production",
    "BRAND_NAME": "UMAXICA"
  },
  // BOOTSTRAP: production points at the DEVELOPMENT VPC Service, exactly as
  // wrangler.jsonc does. AWS cutover replaces only `service_id`.
  "vpc_services": [
    {
      "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
      "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 2000, "period": 60 }
    }
  ],
  "env": {
    "local": {
      "vars": { "EDGE_ENV": "local", "NODE_ENV": "development", "BRAND_NAME": "UMAXICA" },
      "version_metadata": { "binding": "REVISION" },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "5003",
          "simple": { "limit": 2000, "period": 60 }
        }
      ]
    },
    "vpc": {
      "vars": { "EDGE_ENV": "vpc", "NODE_ENV": "development", "BRAND_NAME": "UMAXICA" },
      "version_metadata": { "binding": "REVISION" },
      "vpc_services": [
        {
          "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
          "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7",
          "remote": true
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "4003",
          "simple": { "limit": 2000, "period": 60 }
        }
      ]
    }
  }
}
