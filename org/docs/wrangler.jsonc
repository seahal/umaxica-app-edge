{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-org-docs",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "version_metadata": {
    "binding": "REVISION"
  },
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "umaxica-apps-edge-org-docs"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "upload_source_maps": false,
  "placement": {
    "mode": "smart"
  },
  // The top level IS production; there is no `env.production`.
  // Deploy scripts blank CLOUDFLARE_ENV so a no-`--env` deploy stays production, and the
  // tier reaches the Worker as EDGE_ENV only. tools/check-workers.mjs enforces both.
  "vars": {
    "EDGE_ENV": "production",
    "NODE_ENV": "production",
    "BRAND_NAME": "UMAXICA"
  },

  // BOOTSTRAP: production points at the DEVELOPMENT VPC Service, on purpose.
  //
  // AWS production Rails does not exist yet, and neither does a production tunnel. The one
  // VPC Service that exists terminates on a developer's machine, so a deployed production
  // Worker reaches local Rails through it. That is the point: it is the only way to exercise
  // the real deployed path — Cloudflare edge → Workers VPC → VPC Service → tunnel → Rails —
  // before AWS exists. Production Rails connectivity therefore depends on a laptop being up.
  //
  // No `remote` key here. `remote: true` is a LOCAL-development flag; it makes wrangler proxy
  // the binding out to Cloudflare instead of simulating it, and has no meaning for a deployed
  // Worker, which owns the real binding either way.
  // https://developers.cloudflare.com/workers/development-testing/#remote-bindings
  //
  // AWS cutover, in this order: provision a production tunnel and a production VPC Service,
  // then replace ONLY the `service_id` below. The binding name and every line of application
  // code stay as they are — `getRailsClient()` selects the VPC transport by the presence of
  // the runtime binding, never by an environment name.
  // See adr/006-development-workers-vpc-transport.md.
  "vpc_services": [
    {
      "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
      "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7"
    }
  ],

  "env": {
    "development": {
      "vars": {
        "EDGE_ENV": "development",
        "NODE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      // The ordinary development loop reaches Rails over the real binding.
      //
      // `remote: true` is what makes that possible: wrangler runs this Worker's code in
      // local workerd and proxies only this binding out to Cloudflare, which is the
      // documented way to reach a VPC Service in local development.
      // https://developers.cloudflare.com/workers-vpc/configuration/vpc-services/
      //
      // It has a price, and it is not optional. Wrangler classifies a VPC Service as a
      // resource that can never be simulated locally, so ANY local tooling that resolves
      // this environment opens a remote proxy session — and that session cannot be
      // authenticated with an API token, only with an interactive `wrangler login`.
      // Without one, measured 2026-08-16:
      //   pnpm preview  — fails outright; the OpenNext CLI reads vars through
      //                   getPlatformProxy() and the throw aborts the command.
      //   pnpm dev      — keeps serving, but loses EVERY Cloudflare binding, not just
      //                   this one: the failed session leaves the Cloudflare context
      //                   unpopulated, so REVISION/IMAGES/RATE_LIMITER go with it and
      //                   `pnpm test:api` fails on /revision. `wrangler login` is now a
      //                   prerequisite of the development loop.
      // See adr/006-development-workers-vpc-transport.md.
      //
      // The Node fallback in `src/lib/rails-client.ts` is unaffected and still guarded by
      // EDGE_LOCAL_NODE_RUNTIME + EDGE_LOCAL_RAILS_ENABLED: a wrangler binding is not
      // something a plain Node process can hold, so the two transports stay distinct.
      "vpc_services": [
        {
          "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
          "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7",
          "remote": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "umaxica-apps-edge-org-docs"
        }
      ],
      "version_metadata": {
        "binding": "REVISION"
      },
      "images": {
        "binding": "IMAGES"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2003",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    // `vpc` runs this Worker locally with the VPC binding proxied to the real development VPC
    // Service (`remote: true`, so it needs `wrangler login`). Never deployed, and kept out of
    // `env.development` so `pnpm dev` stays credential-free.
    // See adr/006-development-workers-vpc-transport.md.
    "vpc": {
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "EDGE_ENV": "vpc",
        "NODE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      "version_metadata": {
        "binding": "REVISION"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "umaxica-apps-edge-org-docs"
        }
      ],
      "vpc_services": [
        {
          "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
          "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7",
          "remote": true
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "4003",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    // `test` is never deployed — it only resolves test-tier config for
    // `wrangler dev --env test`. Only non-inheritable keys are repeated here.
    "test": {
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "EDGE_ENV": "test",
        "NODE_ENV": "test",
        "BRAND_NAME": "UMAXICA"
      },
      "version_metadata": {
        "binding": "REVISION"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "umaxica-apps-edge-org-docs"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "3003",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 2000,
        "period": 60
      }
    }
  ]
}
