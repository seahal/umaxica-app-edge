{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-org-docs",
  "main": ".open-next/worker.js",

  /**
   * THREE LIFECYCLE ENVIRONMENTS, AND NOTHING ELSE.
   *
   *   production   this file's top level      wrangler deploy      (no --env)
   *   development  env.development            pnpm dev / preview   (--env development)
   *   test         env.test                   vitest               (--env test)
   *
   * There is no staging, no `env.production`, and no `env.vpc`. A Wrangler
   * environment deploys to a *separate* Worker named `<name>-<env>`
   * (Cloudflare, "Environments"), so an `env.production` would have to
   * re-declare `name` purely to cancel that out. Putting production at the top
   * level makes `wrangler deploy` with no --env the production deploy.
   *
   * Runtime mode and transport mode are SEPARATE AXES from the lifecycle tier.
   * One lifecycle environment (development) is served by two runtimes — Node
   * (`next dev`) and local workerd (`pnpm preview`) — over two different Rails
   * transports. VPC is a binding capability, not an environment. See adr/009.
   */

  "compatibility_date": "2026-05-13",
  /**
   * `nodejs_compat` is only auto-enabled at compatibility_date >= 2026-08-04,
   * and this Worker predates that, so the explicit flag is load-bearing.
   * `global_fetch_strictly_public` stops a deployed Worker reaching a private
   * or non-publicly-resolvable host through the global `fetch()` — which is
   * what makes the VPC binding below the *only* route to Rails rather than
   * merely the intended one. Neither is a leftover. Advancing the date is a
   * separate migration with its own verification; see adr/009.
   */
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "workers_dev": true,
  "upload_source_maps": false,

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.2
    }
  },
  "placement": {
    "mode": "smart"
  },

  /**
   * ---- PRODUCTION ----
   *
   * Everything from here to `env` is the production Worker. These are all
   * non-inheritable keys, so none of it reaches `env.*`; each environment
   * below repeats what it actually needs.
   *
   * The tier is exposed to application code as `EDGE_ENV`, never as
   * `CLOUDFLARE_ENV`. `CLOUDFLARE_ENV` is Wrangler's own control variable: with
   * no --env flag it selects the environment, and `opennextjs-cloudflare
   * upload` reads Worker vars through `getPlatformProxy()` into its own
   * `process.env`, so binding it here would come back as `--env=production`
   * and look for an environment that deliberately does not exist.
   *
   * Re-measured 2026-08-22 on wrangler 4.120.1 with `deploy --dry-run`:
   *   CLOUDFLARE_ENV=development, no --env  ->  EDGE_ENV "development"
   *   CLOUDFLARE_ENV= (blanked),  no --env  ->  EDGE_ENV "production"
   * compose.yaml exports CLOUDFLARE_ENV=development, so every deploy/build
   * script must keep blanking it. tools/check-workers.mjs enforces both rules.
   */
  "vars": {
    "EDGE_ENV": "production",
    "NODE_ENV": "production",
    "BRAND_NAME": "UMAXICA"
  },
  "version_metadata": {
    "binding": "REVISION"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "umaxica-apps-edge-org-docs"
    }
  ],

  /**
   * BOOTSTRAP: production points at the DEVELOPMENT VPC Service.
   *
   * 019f5fe0-287f-7040-9f2f-036cb5b21df7 is bound to the development tunnel
   * (1d501e9a-62f7-4c0d-ba5e-a26e3f10088f) and terminates on a developer's
   * machine. There is exactly one VPC Service on the account — verified
   * 2026-08-22 with `wrangler vpc service list` — because production Rails on
   * AWS does not exist yet.
   *
   * This is a deliberate, temporary migration state, adopted 2026-08-22, NOT a
   * mistake to be silently corrected. It is recorded in
   * tools/workers-manifest.json as `vpcServices.production` with
   * `$productionIsBootstrap: true`; a guardrail requires the development and
   * production ids to DIFFER as soon as that flag is false.
   *
   * No `remote` key: remote bindings are a local-development mechanism, and
   * on deploy "all remote bindings are disabled, which behaves exactly as if
   * they were configured with remote: false" (Cloudflare). Omitting it is how
   * Cloudflare's own get-started example writes a deployed binding.
   *
   * AWS cutover is one value: create the production tunnel and VPC Service,
   * then change this service_id and flip the manifest flag. No application,
   * transport, or development change. See adr/009.
   */
  "vpc_services": [
    {
      "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
      "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7"
    }
  ],

  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 2000,
        "period": 60
      }
    }
  ],

  "env": {
    /**
     * ---- DEVELOPMENT ----
     *
     * The one and only Wrangler development environment, serving two runtimes:
     *
     *   pnpm dev      Node / next dev     -> Rails direct over the private
     *                                        Podman network (EDGE_LOCAL_*).
     *                                        next.config.ts passes
     *                                        `remoteBindings: false`, so no
     *                                        Cloudflare credential is needed.
     *   pnpm preview  local workerd       -> the binding below, resolved
     *                                        remotely against the real
     *                                        development VPC Service.
     *
     * `remote: true` does not upload anything: the Worker still executes in
     * local workerd and only this binding is proxied out to Cloudflare. It
     * does require an interactive `wrangler login` — an API token cannot open
     * the session — so `pnpm preview` costs a credential and `pnpm dev` does
     * not. That is a runtime-mode difference, not a lifecycle one.
     *
     * The application-level API is identical to production:
     * `env.UMAXICA_APPS_EDGE_CF_WORKERS_VPC.fetch(...)`. Only the connection
     * mode differs. src/lib/rails-client.ts contains no environment branch.
     */
    "development": {
      "vars": {
        "EDGE_ENV": "development",
        "NODE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      "version_metadata": {
        "binding": "REVISION"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "umaxica-apps-edge-org-docs"
        }
      ],
      "vpc_services": [
        {
          "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
          "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7",
          "remote": true
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2003",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },

    /**
     * ---- TEST ----
     *
     * Never deployed; exists so `wrangler dev --env test` and a future
     * @cloudflare/vitest-pool-workers setup resolve test-tier config.
     *
     * NO `vpc_services`, and that absence is an invariant rather than an
     * oversight. `vpc_services` being non-inheritable means it must be stated
     * explicitly *by an environment that needs it* — it does not mean every
     * environment must carry every production binding. The test architecture
     * has no Rails dependency, so it gets no Rails transport.
     *
     * Only non-inheritable keys are repeated here; observability, placement,
     * assets and compatibility_* fall through from the top level.
     */
    "test": {
      "vars": {
        "EDGE_ENV": "test",
        "NODE_ENV": "test",
        "BRAND_NAME": "UMAXICA"
      },
      "version_metadata": {
        "binding": "REVISION"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "umaxica-apps-edge-org-docs"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "3003",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    }
  }
}
