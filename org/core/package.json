{
  "name": "umaxica-apps-edge-org-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "EDGE_LOCAL_NODE_RUNTIME=1 next dev --hostname 0.0.0.0 --port 5305",
    "test:e2e": "playwright test",
    "build": "CLOUDFLARE_ENV= opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start --port 5305",
    "deploy": "CLOUDFLARE_ENV= opennextjs-cloudflare build && CLOUDFLARE_ENV= opennextjs-cloudflare deploy",
    "deploy:upload": "CLOUDFLARE_ENV= opennextjs-cloudflare build && CLOUDFLARE_ENV= opennextjs-cloudflare upload",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --yes",
    "upload:ci": "CLOUDFLARE_ENV= opennextjs-cloudflare upload",
    "deploy:ci": "CLOUDFLARE_ENV= opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build --env development && opennextjs-cloudflare preview --env development",
    "preview:vpc": "opennextjs-cloudflare build --env vpc && opennextjs-cloudflare preview --env vpc",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:api": "node api/run.mjs",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "oxlint --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run check:static && pnpm run test",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check:generated": "pnpm run cf-typegen && CLOUDFLARE_ENV= wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run check:generated && pnpm run typecheck && pnpm run knip",
    "check:size": "size-limit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@orangeopensource/hurl": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-react-aria-components": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
