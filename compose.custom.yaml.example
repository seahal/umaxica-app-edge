# Must match `compose.yaml`'s `name:`. Compose takes the project name from the
# LAST file that sets one, so a different value here forks the project: a second
# set of containers and volumes, and `--remove-existing-container` looking under
# the wrong name while the old project still holds the published ports
# (`rootlessport listen tcp 127.0.0.1:5101: bind: address already in use`).
name: umaxica-apps-edge

# TEMPLATE. This file is tracked; `compose.custom.yaml` is not.
#
# `compose.custom.yaml` is the developer-local overlay, loaded unconditionally
# by `.devcontainer/devcontainer.json` and by `scripts/dev-start`. It is
# gitignored so that a host-specific override is never a diff anybody has to
# carry, and `scripts/dev-start` copies this file into place when it is missing.
# Edit your copy freely; edit this template only to change what a fresh clone
# starts with.
#
# It holds the host-portable overrides -- the SELinux relabel opt-out and the
# host GitHub identity below -- and nothing else. The Cloudflare Tunnel
# connector and the external Rails network that used to live here both moved
# out, the former into `compose.yaml` (where it prefers EDGE_CLOUDFLARED_TOKEN
# and falls back to CLOUDFLARED_TOKEN, neither with a `:?` guard) and the latter
# away entirely.
#
# Every value in this template is a `${VAR}` interpolation rather than a literal
# path: it names no machine, so the default copy resolves correctly on every
# host and nobody has to edit their copy just to start the container.
#
# Do not reintroduce a `cloudflare-tunnel:` block here. `security_opt` is a list,
# and Compose appends overlay list entries to the base rather than replacing
# them, so a redeclared `no-new-privileges:true` collides with `compose.yaml`'s
# and Compose v2.24+ rejects the merged file outright:
#   services.cloudflare-tunnel.security_opt items at 0 and 1 are equal
#
services:
  core:
    # SELinux Enforcing (Fedora/RHEL) 向け。compose.yaml の bind mount は
    # :z / :Z を付けていないのでホスト側リポジトリは user_home_t のまま残り、
    # container_t のコンテナからは読めない。uid/gid は keep-id で一致して
    # いるため DAC は通っており、落ちているのは MAC の側だけ
    # (`ls /home/edge/workspace` がディレクトリ一覧すら出せない)。
    #
    # bind mount は . と 16 個の empty.env で計 17 本あり、:z を全部に付けると
    # ホスト側リポジトリを container_file_t へ再ラベルしてしまう。ラベル強制の
    # 無効化はコンテナ1つに閉じ、ホストのラベルを書き換えないのでこちらを取る。
    #
    # 下の known_hosts の bind mount にも :z / :Z を付けないのは同じ理由。
    # label=disable がこのコンテナに閉じて効いており、:z を付ければホスト側の
    # ~/.ssh を再ラベルしてしまう。
    #
    # compose.yaml の `no-new-privileges:true` を再掲しないこと。security_opt は
    # リストで、Compose はオーバーレイ側の要素を base に「追記」するため、再掲は
    # `services.core.security_opt items at 0 and 1 are equal` で弾かれる。
    # 追記だけで狙いどおり [no-new-privileges:true, label=disable] になる。
    # `!override` で置き換える手もあるが、podman-compose 1.5.0 はこのタグを
    # 解釈できず `TypeError: 'OverrideTag' object is not iterable` で落ちるので、
    # プロバイダを選ばないこちらを取る。
    security_opt:
      - label=disable

    # `environment` はマッピングなので Compose はキー単位で base とマージする。
    # compose.yaml の CLOUDFLARE_ENV / DEVCONTAINER はそのまま残る。
    environment:
      # gh CLI の API 認証。トークン本体はこのファイルに書かず、ホスト側の
      # 環境変数からそのまま引き渡す。gh のトークン解決順は
      # GH_TOKEN > GITHUB_TOKEN > 設定ファイル なので、イメージ側に失効した
      # トークンが残っていてもこちらが必ず勝つ。gh auth login は不要。
      #
      # `:?` ではなく `:-` なのが要点。Compose は起動するサービスに関係なく
      # ファイル全体を補間するため、`:?` にするとトークンを持たないマシンでは
      # `podman compose up core` ごと止まる。このオーバーレイは devcontainer から
      # 常時読み込まれるので、それは許容できない。gh は空文字を「未設定」として
      # 扱い hosts.yml へフォールバックするので、空のまま渡して無害。
      GH_TOKEN: ${GH_TOKEN:-}

    # `volumes` はリストだが、下の 1 本は compose.yaml が持たない target なので、
    # target でマージする Compose でも単純追記する podman-compose でも
    # 結果は同じになる。
    volumes:
      # 公開情報だけ。read_only で、しかも known_hosts 1 ファイルのみ。
      # `.ssh` ディレクトリ全体や id_ed25519 等の秘密鍵は絶対にマウントしない
      # (test/development-container-security.test.ts がその 2 つを拒否する)。
      #
      # ホスト側に ~/.ssh/known_hosts が通常ファイルとして存在しない場合、
      # Podman はそのパスを「ディレクトリ」として作ってしまう。それを踏ませない
      # ための事前チェックが scripts/dev-start にある。
      - type: bind
        source: ${HOME}/.ssh/known_hosts
        target: /home/edge/.ssh/known_hosts
        read_only: true
