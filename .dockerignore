# Keep this file aligned with .containerignore. The duplicate policy is
# intentional defense in depth for Docker-compatible build frontends.
.git
.secrets/
node_modules
**/node_modules
.pnpm-store
coverage
# `vite build` output, in every unit.
dist
**/dist
.wrangler
**/.wrangler
.idea
.claude
.aiassistant
plans
*.log

# Compose bind-mounts `.devcontainer/empty.env` onto these paths inside the
# container. Podman creates any missing mount target, and because the workspace
# is itself a bind mount that creation lands on the HOST — owned by a rootless
# subuid (e.g. 524288) with mode 0700, which the unprivileged build frontend
# then cannot read:
#   checking context: no permission to read from '.../app/core/.env.development.local'
# So every successful `devcontainer up` broke the next build. They are
# gitignored and never belong in the image; excluding them breaks the cycle.
**/.env.development.local
