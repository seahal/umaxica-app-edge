{
  "name": "umaxica-apps-edge-apex-net",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --env development --port 5201 --inspector-port 9201 --ip 0.0.0.0",
    "build": "CLOUDFLARE_ENV= wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "preview": "pnpm run build && wrangler dev --config wrangler.jsonc --env development --local --ip 0.0.0.0",
    "deploy": "CLOUDFLARE_ENV= wrangler deploy --config wrangler.jsonc",
    "deploy:upload": "CLOUDFLARE_ENV= wrangler versions upload --config wrangler.jsonc",
    "deploy:promote": "CLOUDFLARE_ENV= wrangler versions deploy --config wrangler.jsonc --yes",
    "upload:ci": "CLOUDFLARE_ENV= wrangler versions upload --config wrangler.jsonc",
    "deploy:ci": "CLOUDFLARE_ENV= wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "CLOUDFLARE_ENV= wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsgo --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/structured-logger": "^0.1.0",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.62.1",
    "wrangler": "catalog:"
  }
}
