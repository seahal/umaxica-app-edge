{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-vpc-probe",
  "main": "probe.mjs",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat"],

  // Never served, never deployed. This Worker exists only to be run by
  // `pnpm run check:vpc` via `wrangler dev`.
  "workers_dev": false,

  // Deliberately TOP LEVEL, which the fifteen frames are forbidden from doing.
  //
  // Their rule exists because a top-level binding is inherited by
  // `env.development`, which would force every ordinary `pnpm dev` to
  // authenticate to Cloudflare. This Worker declares no environments at all, is
  // absent from pnpm-workspace.yaml, and has no deploy script — so there is no
  // environment to leak into and nothing that could ship it. Placing the binding
  // in an `env` block here would mean it is never resolved.
  //
  // tools/check-workers.mjs asserts all of the above. Do not "fix" this to match
  // the frames. See adr/006-development-workers-vpc-transport.md.
  "vpc_services": [
    {
      "binding": "UMAXICA_APPS_EDGE_CF_WORKERS_VPC",
      "service_id": "019f5fe0-287f-7040-9f2f-036cb5b21df7",
      "remote": true
    }
  ]
}
