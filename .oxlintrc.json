{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "afterEach": "readonly",
    "beforeEach": "readonly",
    "describe": "readonly",
    "expect": "readonly",
    "it": "readonly",
    "vi": "readonly"
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "react/no-danger": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/consistent-type-imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/shared/**", "**/shared/*"],
            "message": "shared/ has been removed. Each frame owns its own components, types, hooks, and utilities — copy the implementation into this frame instead of reintroducing a shared module. (Cross-unit imports are a separate invariant, owned by test/deployment-unit-boundaries.test.ts — this rule only stops a shared/ directory coming back.)"
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/.wrangler/**",
    "**/dist/**",
    "**/node_modules/**",
    "worker-configuration.d.ts",
    "**/+types/**",
    "**/build/**"
  ]
}
