    "format:check": "oxfmt --check .",
    "check": "pnpm run check:static && pnpm run test",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run typecheck && pnpm run knip"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.51.0",
