  "private": true,
  "scripts": {
    "dev": "next dev --port 5502",
    "test:e2e": "playwright test",
    "build": "next build",
    "start": "next start --port 5502",
    "deploy": "vercel deploy --prod",
    "typecheck": "tsc --noEmit",
