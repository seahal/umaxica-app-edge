{
  "name": "umaxica-apps-edge-apex-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:css && vercel dev --listen 5501",
    "build:css": "tailwindcss --input ./src/style.css --output ./public/style.css --minify",
    "build": "pnpm run build:css",
    "deploy": "pnpm run build:css && vercel deploy --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "oxlint --report-unused-disable-directives .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run check:static && pnpm run test",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run typecheck && pnpm run knip"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vercel": "catalog:",
    "vitest": "catalog:"
  }
}
