{
  "name": "umaxica-apps-edge-apex-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:css && vercel dev --listen 5501",
    "build:css": "tailwindcss --input ./src/style.css --output ./public/style.css --minify",
    "deploy": "pnpm run build:css && vercel deploy --prod",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "lint": "oxlint --type-aware --fix .",
    "lint:check": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.1",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "catalog:",
    "vercel": "^58.9.1",
    "vitest": "catalog:"
  }
}
