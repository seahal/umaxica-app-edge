{
  "name": "umaxica-apps-edge-dc",
  // This repository no longer runs a Cloudflare Tunnel connector. There is one
  // connector for the whole system, and it lives in the Rails repository — see
  // docs/operations/cloudflare-tunnel-development.md for why, and for the
  // shared-network overlay to add here once that connector is ready.
  "dockerComposeFile": ["../compose.yaml", "./compose.override.yml"],
  "service": "core",
  "remoteUser": "edge",
  "containerUser": "edge",
  "workspaceFolder": "/home/edge/workspace",
  "shutdownAction": "stopCompose",
  "runServices": ["core"],
  "overrideCommand": false,
  "remoteEnv": {
    "EDITOR": "code --wait --reuse-window",
    "DEBUGGER_DISABLE": "1",
    "TERM": "${localEnv:TERM}",
    "COLORTERM": "${localEnv:COLORTERM}"
  },

  // These are the ports the dev servers actually listen on (see the workspace
  // table in CLAUDE.md), forwarded for direct local access.
  //
  // 8976 is wrangler's OAuth callback listener. Ordinary local development does
  // not need it: `vpc_services` is declared in `env.preview` only, so
  // `next dev` / `initOpenNextCloudflareForDev()` resolve no remote binding and
  // never authenticate to Cloudflare (ADR 006, which moved the binding out of
  // `env.production`). It IS needed for the commands that opt into the real
  // binding — `pnpm run check:vpc` and `preview:vpc` — because those require an
  // OAuth session and an API token cannot open one.
  //
  // It MUST be forwarded by VS Code rather than published via Compose:
  // wrangler binds `localhost:8976` inside the container, which a Compose
  // `ports:` mapping cannot reach. VS Code's forwarder runs inside the
  // container and connects over loopback, so it works.
  "forwardPorts": [
    5101, 5103, 5105, 5106, 5107, 5108, 5201, 5301, 5303, 5305, 5306, 5307, 5308, 5401, 5403, 5405,
    5406, 5407, 5408, 5501, 5502, 8976
  ],
  "portsAttributes": {
    "8976": {
      "label": "wrangler OAuth callback",
      "onAutoForward": "silent"
    },
    "5101": {
      "label": "com/apex",
      "onAutoForward": "notify"
    },
    "5103": {
      "label": "com/info",
      "onAutoForward": "silent"
    },
    "5105": {
      "label": "com/core",
      "onAutoForward": "notify"
    },
    "5106": {
      "label": "com/docs",
      "onAutoForward": "silent"
    },
    "5107": {
      "label": "com/news",
      "onAutoForward": "silent"
    },
    "5108": {
      "label": "com/help",
      "onAutoForward": "silent"
    },
    "5201": {
      "label": "net/apex",
      "onAutoForward": "notify"
    },
    "5301": {
      "label": "org/apex",
      "onAutoForward": "notify"
    },
    "5303": {
      "label": "org/info",
      "onAutoForward": "silent"
    },
    "5305": {
      "label": "org/core",
      "onAutoForward": "notify"
    },
    "5306": {
      "label": "org/docs",
      "onAutoForward": "silent"
    },
    "5307": {
      "label": "org/news",
      "onAutoForward": "silent"
    },
    "5308": {
      "label": "org/help",
      "onAutoForward": "silent"
    },
    "5401": {
      "label": "app/apex",
      "onAutoForward": "notify"
    },
    "5403": {
      "label": "app/info",
      "onAutoForward": "silent"
    },
    "5405": {
      "label": "app/core",
      "onAutoForward": "notify"
    },
    "5406": {
      "label": "app/docs",
      "onAutoForward": "silent"
    },
    "5407": {
      "label": "app/news",
      "onAutoForward": "silent"
    },
    "5408": {
      "label": "app/help",
      "onAutoForward": "silent"
    },
    "5501": {
      "label": "dev/apex (Vercel)",
      "onAutoForward": "silent"
    },
    "5502": {
      "label": "dev/acme (Vercel)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-vscode.remote-explorer",
        "GitHub.codespaces",
        "ms-vscode-remote.remote-containers",
        "nicolo-ribaudo.oxfmt-vscode",
        "nicolo-ribaudo.oxc-vscode",

        "-dbaeumer.vscode-eslint",
        "-esbenp.prettier-vscode",
        "-eamodio.gitlens",
        "-GitHub.copilot",
        "-GitHub.copilot-chat"
      ],
      "settings": {
        "claude.allowDangerouslySkipPermissions": true,
        "extensions.verifySignature": false,
        "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.eol": "\n",
        "files.associations": {
          "compose.yaml": "yaml",
          "*.yml": "yaml"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        }
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/marcosbolanos/devcontainer-features/neovim-prebuilt:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/opencode:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/codex:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/edge/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/edge/.claude.json,type=bind",
    "source=${localEnv:HOME}/.copilot,target=/home/edge/.copilot,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/edge/.codex,type=bind",
    "source=${localEnv:HOME}/.gemini,target=/home/edge/.gemini,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/edge/.config/gh,type=bind,readonly",
    "source=${localEnv:HOME}/.config/git,target=/home/edge/.config/git,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/edge/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/edge/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.config/opencode,target=/home/edge/.config/opencode,type=bind,readonly"
  ],
  "updateRemoteUserUID": false
}
