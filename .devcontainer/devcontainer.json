{
  "name": "umaxica-apps-edge",
  // One compose file, the same one `scripts/dev-start` and a bare `podman compose`
  // use, so all three share one project name, one set of containers and one set of
  // volumes. It defines both `core` and the Edge-owned Cloudflare Tunnel connector.
  //
  // `../compose.custom.yaml` is deliberately absent: it is the developer-local
  // overlay, and its Rails network is external and machine-specific, so loading it
  // unconditionally would break every devcontainer that has no such network. Add it
  // here yourself if you want it, or use `scripts/dev-start --rails`.
  "dockerComposeFile": ["../compose.yaml"],
  // compose.yaml builds the image with CONTAINER_UID/GID taken from
  // ${UID}/${GID}. Those are bash builtins rather than exported variables, so
  // without this hook compose silently falls back to 1000 and a host whose UID
  // is not 1000 gets a container whose home and workspace are owned by the
  // wrong user under keep-id — repaired only by a manual chown after every
  // recreate. The script writes the real ids into the gitignored repo-root
  // .env that compose auto-loads.
  //
  // `prune-stale-containers.sh` then removes containers left over from an
  // earlier Compose project name for this same workspace folder. They share the
  // `devcontainer.local_folder` label that `devcontainer exec` searches on, so
  // one stopped leftover is enough to make every exec fail with
  // `container state improper` while naming neither container.
  "initializeCommand": ".devcontainer/write-host-ids.sh && .devcontainer/prune-stale-containers.sh",
  "service": "core",
  "remoteUser": "edge",
  "containerUser": "edge",
  "workspaceFolder": "/home/edge/workspace",
  "shutdownAction": "stopCompose",
  "runServices": ["core", "cloudflare-tunnel"],
  "overrideCommand": false,
  "remoteEnv": {
    "EDITOR": "code --wait --reuse-window",
    "DEBUGGER_DISABLE": "1",
    // Do NOT forward the host's TERM. Ghostty, kitty, and WezTerm ship their
    // own terminfo, so a host value like `xterm-ghostty` has no entry inside
    // the image — `infocmp` fails, `tput clear` fails, and with it Ctrl+L,
    // the arrow keys, history, less, htop, and every TUI. Pin a value the
    // Debian trixie base image is guaranteed to carry in
    // /usr/share/terminfo/x/ instead. COLORTERM is safe to forward: it only
    // signals 24-bit color support and never looks anything up in terminfo.
    "TERM": "xterm-256color",
    "COLORTERM": "${localEnv:COLORTERM}"
  },

  // These are the ports the dev servers actually listen on (see the workspace
  // table in CLAUDE.md), forwarded for direct local access.
  //
  // 8976 is the `wrangler login` browser OAuth callback. Cloudflare access is
  // now obtained interactively inside the container instead of through a
  // mounted API token, so the callback belongs to the base environment.
  "forwardPorts": [
    5101, 5103, 5105, 5106, 5107, 5108, 5201, 5301, 5303, 5305, 5306, 5307, 5308, 5401, 5403, 5405,
    5406, 5407, 5408, 5501, 8976
  ],
  "portsAttributes": {
    "5101": {
      "label": "com/apex",
      "onAutoForward": "notify"
    },
    "5103": {
      "label": "com/info",
      "onAutoForward": "silent"
    },
    "5105": {
      "label": "com/core",
      "onAutoForward": "notify"
    },
    "5106": {
      "label": "com/docs",
      "onAutoForward": "silent"
    },
    "5107": {
      "label": "com/news",
      "onAutoForward": "silent"
    },
    "5108": {
      "label": "com/help",
      "onAutoForward": "silent"
    },
    "5201": {
      "label": "net/apex",
      "onAutoForward": "notify"
    },
    "5301": {
      "label": "org/apex",
      "onAutoForward": "notify"
    },
    "5303": {
      "label": "org/info",
      "onAutoForward": "silent"
    },
    "5305": {
      "label": "org/core",
      "onAutoForward": "notify"
    },
    "5306": {
      "label": "org/docs",
      "onAutoForward": "silent"
    },
    "5307": {
      "label": "org/news",
      "onAutoForward": "silent"
    },
    "5308": {
      "label": "org/help",
      "onAutoForward": "silent"
    },
    "5401": {
      "label": "app/apex",
      "onAutoForward": "notify"
    },
    "5403": {
      "label": "app/info",
      "onAutoForward": "silent"
    },
    "5405": {
      "label": "app/core",
      "onAutoForward": "notify"
    },
    "5406": {
      "label": "app/docs",
      "onAutoForward": "silent"
    },
    "5407": {
      "label": "app/news",
      "onAutoForward": "silent"
    },
    "5408": {
      "label": "app/help",
      "onAutoForward": "silent"
    },
    "5501": {
      "label": "dev/apex",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-vscode.remote-explorer",
        "GitHub.codespaces",
        "ms-vscode-remote.remote-containers",
        "nicolo-ribaudo.oxfmt-vscode",
        "nicolo-ribaudo.oxc-vscode",

        "-dbaeumer.vscode-eslint",
        "-esbenp.prettier-vscode",
        "-eamodio.gitlens",
        "-GitHub.copilot",
        "-GitHub.copilot-chat"
      ],
      "settings": {
        "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.eol": "\n",
        "files.associations": {
          "compose.yaml": "yaml",
          "*.yml": "yaml"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        }
      }
    }
  },

  "features": {
    "ghcr.io/marcosbolanos/devcontainer-features/neovim-prebuilt:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/herdr:1": { "VERSION": "v0.8.0" },
    "ghcr.io/joedmck/devcontainer-features/wrangler:1": {},
    "ghcr.io/srzstephen/devcontainer-features/claude-code:1": {},
    "ghcr.io/nolanjx/devcontainer-features/codex:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/tailscale.com:1": {}
  },
  "updateRemoteUserUID": false
}
